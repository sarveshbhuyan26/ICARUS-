# Reference only: the app reads process environment variables, not this file.
# Optional: bank-backed quizzes work without a key.
GEMINI_API_KEY=
# Optional model override (must be accessible to your provider account).
GEMINI_MODEL=gemini-3.5-flash

# Optional second AI provider. Keys remain server-side; the UI shows configured options.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Google sign-in (public OAuth 2.0 Web client ID).
GOOGLE_CLIENT_ID=
